# Скопіюйте цей файл у .env (він у .gitignore і НЕ потрапляє в git).

# Інстанс Mastodon за замовчуванням
MASTODON_INSTANCE=mastodon.social

# Що збирати (через кому):
#   tag:<хештег>              — хештег на інстансі за замовчуванням
#   tag:<хештег>@<інстанс>    — хештег на іншому інстансі
#   account:<user>@<інстанс>  — пости конкретного акаунта
TARGETS=tag:osint,tag:ukraine,tag:infosec,tag:osint@infosec.exchange

# Необов'язково. Токени доступу (Налаштування → Розробка → Новий застосунок, scope read).
# Кілька токенів через кому → ротація. Порожньо = анонімний доступ до публічних даних.
MASTODON_TOKENS=

# Необов'язково. Проксі (через кому → ротація), напр. http://user:pass@host:port
PROXIES=

# Партії та пейсинг
PAGE_LIMIT=40          # записів на сторінку (максимум API = 40)
PAGES_PER_RUN=3        # сторінок на ціль за один прогін run
BACKFILL_PAGES=5       # сторінок на ціль за один прогін backfill
MIN_INTERVAL=1.5       # секунд між запитами до одного хоста
LOW_REMAINING=10       # якщо X-RateLimit-Remaining <= цього — чекати до Reset

# Повтори та backoff
MAX_RETRIES=5
BACKOFF_BASE=2.0
BACKOFF_MAX=300
HTTP_TIMEOUT=20

# Файли
DB_PATH=data/collector.db
LOG_PATH=data/collector.log
LOG_LEVEL=INFO

# Представтеся серверу чесно (етикет API)
USER_AGENT=edu-social-collector/1.0 (homework; contact: your@email)
